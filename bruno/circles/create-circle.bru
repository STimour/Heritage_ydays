meta {
  name: Create Circle
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/circles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Famille proche",
    "description": "Mon cercle familial",
    "memberIds": []
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("circleId", res.body.id);
  }
}
