meta {
  name: Update My Profile
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/users/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "displayName": "Alice D.",
    "pseudo": "alice_d",
    "photo": "https://example.com/photo.jpg"
  }
}
