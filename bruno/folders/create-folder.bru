meta {
  name: Create Folder
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/folders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Mes souvenirs",
    "privateFolder": false
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("folderId", res.body.id);
  }
}
